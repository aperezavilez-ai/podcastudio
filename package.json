{
  "name": "podcastudio",
  "private": true,
  "version": "2.1.0",
  "description": "PODCASTUDIO - Estudio Profesional de Podcast y Streaming",
  "author": "PodcastStudio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k -s first \"npm run dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.podcastudio.app",
    "productName": "PODCASTUDIO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mux/mux-node": "^14.1.1",
    "@react-three/drei": "^9.108.3",
    "@react-three/fiber": "^8.16.8",
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "fix-webm-duration": "^1.0.6",
    "livepeer": "^3.5.0",
    "mammoth": "^1.12.0",
    "mercadopago": "^2.0.0",
    "raw-body": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "terser": "^5.51.2",
    "three": "^0.165.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.1",
    "wait-on": "^9.5.1"
  }
}
