{
  "name": "podcaststudio",
  "version": "1.2.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "build:exe": "powershell -ExecutionPolicy Bypass -File ./scripts/compile-exe.ps1",
    "build:electron": "vite build && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.13.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.0.0",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.podcaststudio.app",
    "productName": "PodcastStudio",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon.ico",
      "icon.png",
      "package.json"
    ]
  }
}
